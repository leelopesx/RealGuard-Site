{
  "name": "realguard",
  "compatibility_date": "2026-09-01",
  // Worker que responde /api/team, /api/videos e /api/leads no site publicado.
  "main": "worker/index.js",
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
  // A URL da planilha NÃO fica aqui: cadastre SHEETS_URL como variável secreta
  // no painel da Cloudflare (Workers → realguard → Settings → Variables and Secrets).
}
